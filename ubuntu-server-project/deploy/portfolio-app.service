[Unit]
Description=Portfolio Flask application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/ubuntu-server-project/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ubuntu-server-project/app/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
